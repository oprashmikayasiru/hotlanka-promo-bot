{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/studio.js": {
      "memory": 512,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/studio",
      "destination": "/api/studio.js"
    },
    {
      "source": "/api/index",
      "destination": "/api/index.js"
    }
  ]
}
